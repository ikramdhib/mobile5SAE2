<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/loginback"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="top|center_horizontal"> <!-- Align items to the top and center horizontally -->

        <!-- Welcome TextView placed at the top -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Welcome Back!"
            android:textColor="@android:color/white"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" /> <!-- Optional margin from the top -->

        <!-- The rest of the UI elements will be centered below the TextView -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="180dp"
            android:background="@drawable/round_background"
            android:drawableLeft="@drawable/baseline_account_circle_24"
            android:hint="Username"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/round_background"
            android:drawableLeft="@drawable/baseline_lock_24"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="45dp"
            android:onClick="goToForgotPassword"
            android:text="Forgot Password?"
            android:textColor="@android:color/background_dark"
            android:padding="8dp"
            android:minHeight="48dp"/>

        <Button
            android:id="@+id/btnSignIn"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#4D9BD3"
            android:onClick="loginUser"
            android:text="Sign In"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tvCreateAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Create Account"
            android:textColor="@android:color/background_dark"
            android:layout_gravity="center"
            android:textSize="16sp"
            android:onClick="goToCreateAccount"
            android:padding="8dp"
            android:minHeight="48dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
