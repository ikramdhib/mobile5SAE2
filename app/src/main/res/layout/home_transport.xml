<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4D9BD3"
    tools:context=".TransportManagementActivity">

    <!-- Location Text -->
    <TextView
        android:id="@+id/location_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location"
        android:textColor="#000000"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Location Name -->
    <TextView
        android:id="@+id/location_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New York, USA"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/location_text"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Search Bar -->
    <EditText
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Search"
        android:padding="12dp"
        android:background="@drawable/search_bar_background"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/location_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Categories Section -->
    <TextView
        android:id="@+id/categories_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Categories"
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/search_bar"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Categories Layout -->
    <LinearLayout
        android:id="@+id/categories_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/categories_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Lake Category -->
        <LinearLayout
            android:id="@+id/category_lake_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:background="@drawable/category_background"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="#FFFFFF"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/lake_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/lakes"
                android:contentDescription="Lake" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lakes"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Sea Category -->
        <LinearLayout
            android:id="@+id/category_sea_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:background="@drawable/category_background"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="#FFFFFF"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/sea_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/sea"
                android:contentDescription="Sea" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sea"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Mountain Category -->
        <LinearLayout
            android:id="@+id/category_mountain_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:background="@drawable/category_background"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="#FFFFFF"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/mountain_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/mountain"
                android:contentDescription="Mountain" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mountain"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Forest Category -->
        <LinearLayout
            android:id="@+id/category_forest_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:background="@drawable/category_background"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="#FFFFFF"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/forest_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/cat3"
                android:contentDescription="Forest" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forest"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Transport Type Section -->
    <TextView
        android:id="@+id/transport_type_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose Your Transport Type"
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/categories_layout"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Transport Options Container -->
    <LinearLayout
        android:id="@+id/transport_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/transport_type_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Car Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/transport_background">

            <ImageView
                android:id="@+id/car_image"
                android:layout_width="160dp"
                android:layout_height="150dp"
                android:src="@drawable/cars"
                android:contentDescription="Car" />

            <Button
                android:id="@+id/see_all_cars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See All"
                android:backgroundTint="#673AB7"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Bus Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="8dp"
            android:gravity="center"
            android:background="@drawable/transport_background">

            <ImageView
                android:id="@+id/bus_image"
                android:layout_width="160dp"
                android:layout_height="150dp"
                android:src="@drawable/bus"
                android:contentDescription="Bus" />

            <Button
                android:id="@+id/see_all_buses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See All"
                android:backgroundTint="#673AB7"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
