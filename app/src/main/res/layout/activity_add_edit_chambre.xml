<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/blue2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="16dp"
        android:elevation="4dp"
        android:layout_margin="8dp">

        <!-- Titre de l'activité -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="Ajouter / Modifier une Chambre"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Type de Chambre -->
        <EditText
            android:id="@+id/etChambreType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type de chambre (ex. : Suite, Double)"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <!-- Nombre d'Adultes -->
        <EditText
            android:id="@+id/etNbAdultes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre d'adultes"
            android:inputType="number"
            android:layout_marginBottom="12dp" />

        <!-- Nombre d'Enfants -->
        <EditText
            android:id="@+id/etNbEnfants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre d'enfants"
            android:inputType="number"
            android:layout_marginBottom="12dp" />

        <!-- Prix par nuit -->
        <EditText
            android:id="@+id/etPricePerNight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Prix par nuit (TND)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp" />

        <!-- Date de Début de Disponibilité -->
        <EditText
            android:id="@+id/etDateDebutDisponibilite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date de début de disponibilité"
            android:focusable="false"
            android:inputType="date"
            android:layout_marginBottom="12dp" />

        <!-- Date de Fin de Disponibilité -->
        <EditText
            android:id="@+id/etDateFinDisponibilite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date de fin de disponibilité"
            android:focusable="false"
            android:inputType="date"
            android:layout_marginBottom="12dp" />
        <!-- ID de l'Hôtel -->
        <Spinner
            android:id="@+id/spinnerHotelId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:spinnerMode="dropdown"
             />

        <!-- Bouton Enregistrer -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enregistrer"
            android:backgroundTint="@color/blue3"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:paddingVertical="12dp" />


    </LinearLayout>
</ScrollView>
