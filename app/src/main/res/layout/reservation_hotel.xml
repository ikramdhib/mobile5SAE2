<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/blue2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="16dp"
        android:elevation="4dp"
        android:layout_margin="8dp">

        <!-- Nom de l'hôtel -->
        <TextView
            android:id="@+id/hotelNameReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom de l'hôtel"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <!-- Emplacement de l'hôtel -->
        <TextView
            android:id="@+id/hotelLocationReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emplacement"
            android:textSize="16sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp"/>

        <!-- Prix par nuit -->
        <TextView
            android:id="@+id/hotelPriceReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prix par nuit"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1957A8"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:id="@+id/hotelRoomTypeReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Type de chambre"
            android:textSize="16sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp"/>

        <!-- Date d'arrivée -->
        <Button
            android:id="@+id/checkInDateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date d'arrivée"
            android:backgroundTint="@color/blue3"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:paddingVertical="12dp"/>

        <!-- Date de départ -->
        <Button
            android:id="@+id/checkOutDateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date de départ"
            android:backgroundTint="@color/blue3"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:paddingVertical="12dp"/>

        <!-- Bouton pour confirmer la réservation -->
        <Button
            android:id="@+id/confirmReservationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmer la réservation"
            android:backgroundTint="@color/blue3"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:paddingVertical="12dp"/>
    </LinearLayout>
</ScrollView>
