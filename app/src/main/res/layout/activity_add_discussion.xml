<?xml version="1.0" encoding="utf-8"?>
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ADD8E6"
        android:padding="16dp">

        <!-- ImageView pour l'image en arrière-plan -->
        <ImageView
            android:id="@+id/background_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/background_image"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:alpha="0.5"
            android:scaleType="centerInside" />

        <!-- Titre de la page -->
        <TextView
            android:id="@+id/add_discussion_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajouter une discussion"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="24dp" />

        <!-- Champ de titre de la discussion -->
        <EditText
            android:id="@+id/discussion_title_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/add_discussion_title"
            android:layout_marginTop="16dp"
            android:hint="Titre de la discussion (optionnel)"
            android:background="@android:color/white"
            android:padding="12dp" />

        <!-- Zone de saisie de la discussion -->
        <EditText
            android:id="@+id/discussion_input"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_below="@id/discussion_title_input"
            android:layout_above="@id/submit_button"
            android:hint="Écrivez votre discussion ici..."
            android:background="@android:color/white"
            android:gravity="start"
            android:minHeight="200dp"
            android:padding="16dp" />

        <!-- Bouton de soumission -->
        <Button
            android:id="@+id/submit_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Soumettre"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#0077b6"
            android:textColor="@android:color/white" />

    </RelativeLayout>
