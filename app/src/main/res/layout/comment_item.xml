<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- Auteur du commentaire -->
        <TextView
            android:id="@+id/comment_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auteur"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <!-- Contenu du commentaire (Affichage normal) -->
        <TextView
            android:id="@+id/comment_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/comment_username"
            android:text="Contenu du commentaire"
            android:layout_marginBottom="4dp" />

        <!-- Champ de texte pour modifier le commentaire -->
        <EditText
            android:id="@+id/edit_comment_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/comment_username"
            android:visibility="gone"
            android:hint="Modifier le commentaire"
            android:background="@android:color/white"
            android:padding="8dp"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <!-- Date du commentaire -->
        <TextView
            android:id="@+id/comment_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/comment_content"
            android:text="Date de création"
            android:textSize="12sp"
            android:textColor="#808080" />

        <!-- Bouton Modifier (Icône) -->
        <ImageView
            android:id="@+id/comment_edit_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_edit"
            android:contentDescription="Modifier le commentaire" />

        <!-- Bouton Supprimer (Icône) -->
        <ImageView
            android:id="@+id/comment_delete_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/comment_edit_button"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="Supprimer le commentaire" />

        <!-- Bouton Sauvegarder les modifications -->
        <Button
            android:id="@+id/comment_save_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sauvegarder"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/edit_comment_content"
            android:visibility="gone"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#0077b6"
            android:textColor="@android:color/white"
            android:layout_marginTop="4dp" />
    </RelativeLayout>

</androidx.cardview.widget.CardView>
