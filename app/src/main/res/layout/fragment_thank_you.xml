<!-- res/layout/fragment_thank_you.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#4D9BD3"
    android:padding="16dp">

    <!-- Back Button -->
    <TextView
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textSize="16sp"
        android:padding="8dp"
        android:onClick="onBackClicked"
        android:textColor="@color/black" />

    <!-- Thank You Image -->
    <ImageView
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:src="@drawable/thankyour"
        android:contentDescription="Thank You" />

    <!-- Thank You Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thank You"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:paddingTop="16dp"
        android:fontFamily="sans-serif-medium" />

    <!-- Booking Confirmation Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your booking has been placed and sent to Md. Sharif Ahmed"
        android:textSize="16sp"
        android:textColor="@color/gray_text"
        android:paddingTop="8dp" />

    <!-- Reservation Details TextView (Added this) -->
    <TextView
        android:id="@+id/reservationDetailsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reservation Details will appear here"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:paddingTop="16dp" />

    <!-- Confirm Ride Button -->
    <Button
        android:id="@+id/confirmRideButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm Ride"
        android:textColor="@color/white"
        android:backgroundTint="@color/cardview_dark_background"
        android:layout_marginTop="24dp" />
</LinearLayout>
