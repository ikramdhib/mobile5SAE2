<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- État lorsque le bouton est appuyé -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#3F51B5" /> <!-- Couleur de fond quand appuyé -->
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#491A1A" />
        </shape>
    </item>

    <!-- État par défaut (non appuyé) -->
    <item>
        <shape>
            <solid android:color="@color/blue3" /> <!-- Couleur de fond par défaut -->
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#491A1A" />
        </shape>
    </item>
</selector>
